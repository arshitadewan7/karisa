# Only needed in production. Locally the app makes its own secret.
NODE_ENV=production
# A long random string. Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# The public address of the site, exactly as people visit it
BETTER_AUTH_URL=https://yourdomain.com
# Where the database and photos live (a persistent volume in production)
DATA_DIR=/data
# Optional: extra allowed origins, comma separated (e.g. https://www.yourdomain.com)
TRUSTED_ORIGINS=
